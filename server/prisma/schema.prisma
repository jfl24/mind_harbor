// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  UTILISATEUR
  ADMINISTRATEUR
}

enum ProfileVisibility {
  PUBLIC
  GROUPES_SEULEMENT
  PRIVE
}

enum GroupMemberStatus {
  MODERATEUR
  MEMBRE
}

enum ContactLevel {
  PERSONNE
  MEMBRES_DE_MES_GROUPES
  TOUT_LE_MONDE
}

enum GroupVisibility {
  PUBLIC
  PRIVE
}

enum MembershipStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum ReportCategory {
  INAPPROPRIE
  SPAM
  INQUIETANT
}

enum ReportStatus {
  EN_ATTENTE
  TRAITE
  REJETE
}

enum ActivityCategory {
  EXERCICE
  BIEN_ETRE
  LOISIR
  SORTIE
}

enum ResourceType {
  ARTICLE
  VIDEO
  AUDIO
  EXERCICE
  FICHE
}

enum ResourceCategory {
  ANXIETE
  SOMMEIL
  RELATIONS
  TRAVAIL
  DEUIL
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role Role @default(UTILISATEUR)
  pseudonyme String?
  nom String?
  prenom String?
  avatar String?
  bio String?
  profileVisibility ProfileVisibility @default(PUBLIC)
  contactLevel ContactLevel @default(TOUT_LE_MONDE)
  suspended Boolean @default(false)
  autoriseMessages Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  
  // Journal
  journalEntries JournalEntry[]

  // Groupes créés
  groupsModerateur Group[]
  groupsMembership GroupMembership[]
  
  // Messagerie 
  sentMessages Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  
  // Ressources favorites
  favorites Favorite[]

  // Posts
  posts Post[]
  comments Comment[]

  // Reports
  reports Report[]

  // Tokens
  refreshTokens RefreshToken[]

  userBlocked String[]
}

model JournalEntry {
  id Int @id @default(autoincrement())
  userId String
  date DateTime @db.Date
  humeur Int
  energie Int
  sommeil Int 
  anxiete Int
  activities JournalActivity[]
  evenements String?
  gratitude String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([userId, date])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalActivity {
  id Int @id @default(autoincrement())
  journalEntryId Int
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  activityId Int
  activity Activity @relation(fields: [activityId], references: [id])
  @@unique([journalEntryId, activityId])
}

model Activity {
  id Int @id @default(autoincrement())
  name String
  categorie ActivityCategory?
  description String?
  createdAt DateTime @default(now())
  journalActivities JournalActivity[]
}

model Message {
  id String @id @default(uuid())
  senderId String
  sender User @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  content String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
}

model Resource {
  id String @id @default(uuid())
  titre String
  description String
  type ResourceType
  categorie ResourceCategory
  url String
  duree Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  favoris Favorite[]
}

model Favorite {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@unique([userId, resourceId])
}

model Group {
  id Int @id @default(autoincrement())
  nom String
  description String
  thematique String?
  regles String?
  groupVisibility GroupVisibility @default(PUBLIC)
  moderateurId String
  moderateur User @relation(fields: [moderateurId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  groupMemberships GroupMembership[]
  posts Post[]
}

model GroupMembership {
  id Int @id @default(autoincrement())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  groupMemberStatus GroupMemberStatus @default(MEMBRE)
  membershipStatus MembershipStatus @default(EN_ATTENTE)
  joinedAt DateTime @default(now()) 
}

model Post {
  id Int @id @default(autoincrement())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  comments Comment[]
  report Report[]
}

model Comment {
  id Int @id @default(autoincrement())
  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Report {
  id Int @id @default(autoincrement())
  reporterId String
  reporter User @relation(fields: [reporterId], references: [id])
  postId Int
  post Post @relation(fields: [postId], references: [id])
  reportCategory ReportCategory @default(INAPPROPRIE)
  reportStatus ReportStatus @default(EN_ATTENTE)
  raison String?
  createdAt DateTime @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  
}

model RefreshToken {
  id String @id @default(uuid())
  token String @unique
  expiresAt DateTime
  revoked Boolean @default(false)
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
